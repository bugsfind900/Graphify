dev tun
persist-tun
persist-key
data-ciphers AES-128-GCM:AES-128-CBC
data-ciphers-fallback AES-128-CBC
auth SHA256
tls-client
client
resolv-retry infinite

remote 111.93.148.162 1195 udp
remote 203.101.111.246 1195 udp
remote 49.204.92.114 1195 udp

nobind
verify-x509-name "openvpn_server" name
pkcs12 1st-UDP4-1195-sourabh.devera@nobroker.in.p12
tls-auth 1st-UDP4-1195-sourabh.devera@nobroker.in-tls.key 1
remote-cert-tls server
explicit-exit-notify

# ---------------------------------------
# SPLIT TUNNEL + FIX FOR 403 + SPEED FIX
# ---------------------------------------

# Block server forcing full tunnel
pull-filter ignore redirect-gateway
pull-filter ignore "redirect-private"

# Do not accept server-pushed routes
route-nopull

# Office internal network
route 10.0.0.0 255.0.0.0

# Office-restricted PUBLIC services
# (service.nobrokerhood.com)
route 34.117.82.184 255.255.255.255

# (RabbitMQ dashboard)
route 35.200.238.167 255.255.255.255

# Use fast DNS (avoid office DNS)
dhcp-option DNS 8.8.8.8
dhcp-option DNS 1.1.1.1

